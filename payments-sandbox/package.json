{
  "name": "millennium-pix-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node --test database/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:database && npm run test:e2e"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "qrcode": "1.5.4",
    "lucide": "1.51.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "pg": "8.23.1"
  }
}
